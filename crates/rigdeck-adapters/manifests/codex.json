{
  "schema_version": 1,
  "adapter_id": "codex",
  "version": "1.0.0",
  "display_name": "Codex",
  "protocol": { "min": 1, "max": 1 },
  "platforms": ["windows", "macos", "linux"],
  "detection": [
    { "path": "{home}/.codex", "markers": [], "profile": null, "version_hint": "codex --version" },
    { "path": "{project}/.agents", "markers": [], "profile": "project", "version_hint": null }
  ],
  "capabilities": [
    { "asset_kind": "skill", "scopes": ["global", "project"], "operations": ["import", "install", "update", "toggle", "remove", "drift"] },
    { "asset_kind": "prompt", "scopes": ["global", "project"], "operations": ["import", "install", "update", "toggle", "remove", "drift"] },
    { "asset_kind": "mcp_server", "scopes": ["global"], "operations": ["import", "install", "update", "toggle", "remove", "drift"] }
  ],
  "scopes": [
    { "id": "global", "display_name": "全局", "project_required": false },
    { "id": "project", "display_name": "项目", "project_required": true }
  ],
  "native_formats": [
    { "id": "skill-directory", "preserves_comments": true, "preserves_unknown_fields": true },
    { "id": "markdown", "preserves_comments": true, "preserves_unknown_fields": true },
    { "id": "toml", "preserves_comments": true, "preserves_unknown_fields": true }
  ],
  "codecs": [
    { "id": "agent-skill-v1", "asset_kind": "skill", "native_format": "skill-directory" },
    { "id": "bounded-markdown-v1", "asset_kind": "prompt", "native_format": "markdown" },
    { "id": "codex-mcp-toml-v1", "asset_kind": "mcp_server", "native_format": "toml" }
  ],
  "surfaces": [
    { "id": "global-skills", "scope": "global", "asset_kind": "skill", "root": "{home}", "target": ".agents/skills/{name}", "native_format": "skill-directory", "section": null, "mode": "directory_tree", "writable": true, "precedence": 0 },
    { "id": "global-skills-legacy", "scope": "global", "asset_kind": "skill", "root": "{home}", "target": ".codex/skills/{name}", "native_format": "skill-directory", "section": null, "mode": "directory_tree", "writable": false, "precedence": 100 },
    { "id": "project-skills", "scope": "project", "asset_kind": "skill", "root": "{project}", "target": ".agents/skills/{name}", "native_format": "skill-directory", "section": null, "mode": "directory_tree", "writable": true, "precedence": 0 },
    { "id": "global-instructions", "scope": "global", "asset_kind": "prompt", "root": "{home}", "target": ".codex/AGENTS.md", "native_format": "markdown", "section": null, "mode": "managed_block", "writable": true, "precedence": 0 },
    { "id": "project-instructions", "scope": "project", "asset_kind": "prompt", "root": "{project}", "target": "AGENTS.md", "native_format": "markdown", "section": null, "mode": "managed_block", "writable": true, "precedence": 0 },
    { "id": "global-mcp", "scope": "global", "asset_kind": "mcp_server", "root": "{home}", "target": ".codex/config.toml", "native_format": "toml", "section": "mcp_servers", "mode": "structured_entry", "writable": true, "precedence": 0 }
  ],
  "limitations": [],
  "official_docs": ["https://developers.openai.com/codex/skills", "https://developers.openai.com/codex/guides/agents-md", "https://developers.openai.com/codex/config-reference", "https://developers.openai.com/codex/mcp"],
  "helper": null
}
