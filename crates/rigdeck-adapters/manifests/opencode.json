{
  "schema_version": 1,
  "adapter_id": "opencode",
  "version": "1.0.0",
  "display_name": "OpenCode",
  "protocol": { "min": 1, "max": 1 },
  "platforms": ["windows", "macos", "linux"],
  "detection": [
    { "path": "{home}/.config/opencode", "markers": [], "profile": null, "version_hint": "opencode --version" },
    { "path": "{project}/.opencode", "markers": [], "profile": "project", "version_hint": null }
  ],
  "capabilities": [
    { "asset_kind": "skill", "scopes": ["global", "project"], "operations": ["import", "install", "update", "toggle", "remove", "drift"] },
    { "asset_kind": "prompt", "scopes": ["global", "project"], "operations": ["import", "install", "update", "toggle", "remove", "drift"] },
    { "asset_kind": "mcp_server", "scopes": ["global", "project"], "operations": ["import", "install", "update", "toggle", "remove", "drift"] }
  ],
  "scopes": [
    { "id": "global", "display_name": "全局", "project_required": false },
    { "id": "project", "display_name": "项目", "project_required": true }
  ],
  "native_formats": [
    { "id": "skill-directory", "preserves_comments": true, "preserves_unknown_fields": true },
    { "id": "markdown", "preserves_comments": true, "preserves_unknown_fields": true },
    { "id": "jsonc", "preserves_comments": true, "preserves_unknown_fields": true }
  ],
  "codecs": [
    { "id": "agent-skill-v1", "asset_kind": "skill", "native_format": "skill-directory" },
    { "id": "bounded-markdown-v1", "asset_kind": "prompt", "native_format": "markdown" },
    { "id": "opencode-jsonc-v1", "asset_kind": "mcp_server", "native_format": "jsonc" }
  ],
  "surfaces": [
    { "id": "global-skills", "scope": "global", "asset_kind": "skill", "root": "{home}", "target": ".config/opencode/skills/{name}", "native_format": "skill-directory", "section": null, "mode": "directory_tree", "writable": true, "precedence": 0 },
    { "id": "project-skills", "scope": "project", "asset_kind": "skill", "root": "{project}", "target": ".opencode/skills/{name}", "native_format": "skill-directory", "section": null, "mode": "directory_tree", "writable": true, "precedence": 0 },
    { "id": "project-skills-agent-standard", "scope": "project", "asset_kind": "skill", "root": "{project}", "target": ".agents/skills/{name}", "native_format": "skill-directory", "section": null, "mode": "directory_tree", "writable": false, "precedence": 10 },
    { "id": "global-instructions", "scope": "global", "asset_kind": "prompt", "root": "{home}", "target": ".config/opencode/AGENTS.md", "native_format": "markdown", "section": null, "mode": "managed_block", "writable": true, "precedence": 0 },
    { "id": "project-instructions", "scope": "project", "asset_kind": "prompt", "root": "{project}", "target": "AGENTS.md", "native_format": "markdown", "section": null, "mode": "managed_block", "writable": true, "precedence": 0 },
    { "id": "global-mcp", "scope": "global", "asset_kind": "mcp_server", "root": "{home}", "target": ".config/opencode/opencode.jsonc", "native_format": "jsonc", "section": "mcp", "mode": "structured_entry", "writable": true, "precedence": 0 },
    { "id": "project-mcp", "scope": "project", "asset_kind": "mcp_server", "root": "{project}", "target": "opencode.jsonc", "native_format": "jsonc", "section": "mcp", "mode": "structured_entry", "writable": true, "precedence": 0 }
  ],
  "limitations": [],
  "official_docs": ["https://opencode.ai/docs/skills/", "https://opencode.ai/docs/rules/", "https://opencode.ai/docs/config/", "https://opencode.ai/docs/mcp-servers/"],
  "helper": null
}
