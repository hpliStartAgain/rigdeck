{
  "schema_version": 1,
  "adapter_id": "claude-code",
  "version": "1.0.0",
  "display_name": "Claude Code",
  "protocol": { "min": 1, "max": 1 },
  "platforms": ["windows", "macos", "linux"],
  "detection": [
    { "path": "{home}/.claude", "markers": [], "profile": null, "version_hint": "claude --version" },
    { "path": "{project}/.claude", "markers": [], "profile": "project", "version_hint": null }
  ],
  "capabilities": [
    { "asset_kind": "skill", "scopes": ["global", "project"], "operations": ["import", "install", "update", "toggle", "remove", "drift"] },
    { "asset_kind": "prompt", "scopes": ["global", "project"], "operations": ["import", "install", "update", "toggle", "remove", "drift"] },
    { "asset_kind": "mcp_server", "scopes": ["global", "project"], "operations": ["import", "install", "update", "toggle", "remove", "drift"] }
  ],
  "scopes": [
    { "id": "global", "display_name": "个人", "project_required": false },
    { "id": "project", "display_name": "项目", "project_required": true }
  ],
  "native_formats": [
    { "id": "skill-directory", "preserves_comments": true, "preserves_unknown_fields": true },
    { "id": "markdown", "preserves_comments": true, "preserves_unknown_fields": true },
    { "id": "json", "preserves_comments": false, "preserves_unknown_fields": true }
  ],
  "codecs": [
    { "id": "agent-skill-v1", "asset_kind": "skill", "native_format": "skill-directory" },
    { "id": "bounded-markdown-v1", "asset_kind": "prompt", "native_format": "markdown" },
    { "id": "claude-mcp-v1", "asset_kind": "mcp_server", "native_format": "json" }
  ],
  "surfaces": [
    { "id": "global-skills", "scope": "global", "asset_kind": "skill", "root": "{home}", "target": ".claude/skills/{name}", "native_format": "skill-directory", "section": null, "mode": "directory_tree", "writable": true, "precedence": 0 },
    { "id": "project-skills", "scope": "project", "asset_kind": "skill", "root": "{project}", "target": ".claude/skills/{name}", "native_format": "skill-directory", "section": null, "mode": "directory_tree", "writable": true, "precedence": 0 },
    { "id": "global-instructions", "scope": "global", "asset_kind": "prompt", "root": "{home}", "target": ".claude/CLAUDE.md", "native_format": "markdown", "section": null, "mode": "managed_block", "writable": true, "precedence": 0 },
    { "id": "project-instructions", "scope": "project", "asset_kind": "prompt", "root": "{project}", "target": "CLAUDE.md", "native_format": "markdown", "section": null, "mode": "managed_block", "writable": true, "precedence": 0 },
    { "id": "global-mcp", "scope": "global", "asset_kind": "mcp_server", "root": "{home}", "target": ".claude.json", "native_format": "json", "section": "mcpServers", "mode": "structured_entry", "writable": true, "precedence": 0 },
    { "id": "project-mcp", "scope": "project", "asset_kind": "mcp_server", "root": "{project}", "target": ".mcp.json", "native_format": "json", "section": "mcpServers", "mode": "structured_entry", "writable": true, "precedence": 0 }
  ],
  "limitations": [],
  "official_docs": ["https://code.claude.com/docs/en/claude-directory", "https://code.claude.com/docs/en/skills", "https://code.claude.com/docs/en/mcp"],
  "helper": null
}
