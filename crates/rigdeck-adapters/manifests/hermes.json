{
  "schema_version": 1,
  "adapter_id": "hermes",
  "version": "1.0.0",
  "display_name": "Hermes Agent",
  "protocol": { "min": 1, "max": 1 },
  "platforms": ["windows", "macos", "linux"],
  "detection": [
    { "path": "{home}/.hermes", "markers": [], "profile": null, "version_hint": "hermes --version" },
    { "path": "{project}/.hermes", "markers": [], "profile": "project", "version_hint": null }
  ],
  "capabilities": [
    { "asset_kind": "skill", "scopes": ["global", "project"], "operations": ["import", "install", "update", "toggle", "remove", "drift"] },
    { "asset_kind": "prompt", "scopes": ["global", "project"], "operations": ["import", "install", "update", "toggle", "remove", "drift"] },
    { "asset_kind": "mcp_server", "scopes": ["global"], "operations": ["import", "install", "update", "toggle", "remove", "drift"] }
  ],
  "scopes": [
    { "id": "global", "display_name": "全局", "project_required": false },
    { "id": "project", "display_name": "项目", "project_required": true }
  ],
  "native_formats": [
    { "id": "skill-directory", "preserves_comments": true, "preserves_unknown_fields": true },
    { "id": "markdown", "preserves_comments": true, "preserves_unknown_fields": true },
    { "id": "yaml", "preserves_comments": true, "preserves_unknown_fields": true }
  ],
  "codecs": [
    { "id": "agent-skill-v1", "asset_kind": "skill", "native_format": "skill-directory" },
    { "id": "bounded-markdown-v1", "asset_kind": "prompt", "native_format": "markdown" },
    { "id": "hermes-yaml-v1", "asset_kind": "mcp_server", "native_format": "yaml" }
  ],
  "surfaces": [
    { "id": "global-skills", "scope": "global", "asset_kind": "skill", "root": "{home}", "target": ".hermes/skills/{name}", "native_format": "skill-directory", "section": null, "mode": "directory_tree", "writable": true, "precedence": 0 },
    { "id": "project-skills", "scope": "project", "asset_kind": "skill", "root": "{project}", "target": ".agents/skills/{name}", "native_format": "skill-directory", "section": null, "mode": "directory_tree", "writable": true, "precedence": 0 },
    { "id": "global-soul", "scope": "global", "asset_kind": "prompt", "root": "{home}", "target": ".hermes/SOUL.md", "native_format": "markdown", "section": null, "mode": "managed_block", "writable": true, "precedence": 0 },
    { "id": "project-context", "scope": "project", "asset_kind": "prompt", "root": "{project}", "target": ".hermes.md", "native_format": "markdown", "section": null, "mode": "managed_block", "writable": true, "precedence": 0 },
    { "id": "global-mcp", "scope": "global", "asset_kind": "mcp_server", "root": "{home}", "target": ".hermes/config.yaml", "native_format": "yaml", "section": "mcp_servers", "mode": "structured_entry", "writable": true, "precedence": 0 }
  ],
  "limitations": [
    { "code": "external_skill_dirs_dynamic", "message": "额外 Skill 目录来自用户 config.yaml，需在检测后动态加入 surface。", "recovery": "运行完整刷新；RigDeck 会读取配置并建立只在该实例内生效的动态 surface。" }
  ],
  "official_docs": ["https://github.com/NousResearch/hermes-agent", "https://github.com/NousResearch/hermes-agent/blob/main/docs/skills.md", "https://github.com/NousResearch/hermes-agent/blob/main/docs/mcp.md"],
  "helper": null
}
