{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rigdeck.app/schema/adapter-v1.json",
  "title": "RigDeck Adapter Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "adapter_id", "version", "display_name", "protocol",
    "platforms", "detection", "capabilities", "scopes", "native_formats",
    "codecs", "surfaces", "official_docs"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "adapter_id": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
    "version": { "type": "string", "minLength": 1 },
    "display_name": { "type": "string", "minLength": 1 },
    "protocol": {
      "type": "object", "additionalProperties": false, "required": ["min", "max"],
      "properties": { "min": { "type": "integer", "minimum": 1 }, "max": { "type": "integer", "minimum": 1 } }
    },
    "platforms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["windows", "macos", "linux"] } },
    "detection": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/detection" } },
    "capabilities": { "type": "array", "items": { "$ref": "#/$defs/capability" } },
    "scopes": { "type": "array", "items": { "$ref": "#/$defs/scope" } },
    "native_formats": { "type": "array", "items": { "$ref": "#/$defs/nativeFormat" } },
    "codecs": { "type": "array", "items": { "$ref": "#/$defs/codec" } },
    "surfaces": { "type": "array", "items": { "$ref": "#/$defs/surface" } },
    "limitations": { "type": "array", "default": [], "items": { "$ref": "#/$defs/limitation" } },
    "official_docs": { "type": "array", "items": { "type": "string", "format": "uri" } },
    "helper": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/helper" }] },
    "deprecation": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/deprecation" }] }
  },
  "$defs": {
    "assetKind": { "enum": ["skill", "prompt", "mcp_server"] },
    "operation": { "enum": ["import", "install", "update", "toggle", "remove", "drift"] },
    "detection": {
      "type": "object", "additionalProperties": false, "required": ["path"],
      "properties": {
        "path": { "type": "string", "pattern": "^\\{(home|project)\\}" },
        "markers": { "type": "array", "default": [], "items": { "type": "string" } },
        "profile": { "type": ["string", "null"] },
        "version_hint": { "type": ["string", "null"] }
      }
    },
    "capability": {
      "type": "object", "additionalProperties": false, "required": ["asset_kind", "scopes", "operations"],
      "properties": {
        "asset_kind": { "$ref": "#/$defs/assetKind" },
        "scopes": { "type": "array", "items": { "type": "string" } },
        "operations": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/operation" } }
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false, "required": ["id", "display_name", "project_required"],
      "properties": { "id": { "type": "string" }, "display_name": { "type": "string" }, "project_required": { "type": "boolean" } }
    },
    "nativeFormat": {
      "type": "object", "additionalProperties": false, "required": ["id", "preserves_comments", "preserves_unknown_fields"],
      "properties": { "id": { "type": "string" }, "preserves_comments": { "type": "boolean" }, "preserves_unknown_fields": { "type": "boolean" } }
    },
    "codec": {
      "type": "object", "additionalProperties": false, "required": ["id", "asset_kind", "native_format"],
      "properties": { "id": { "type": "string" }, "asset_kind": { "$ref": "#/$defs/assetKind" }, "native_format": { "type": "string" } }
    },
    "surface": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "scope", "asset_kind", "root", "target", "native_format", "mode", "writable", "precedence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "asset_kind": { "$ref": "#/$defs/assetKind" },
        "root": { "type": "string", "pattern": "^\\{(home|project)\\}" },
        "target": { "type": "string" },
        "native_format": { "type": "string" },
        "section": { "type": ["string", "null"] },
        "mode": { "enum": ["replace_file", "directory_tree", "managed_block", "structured_entry", "manual_required"] },
        "writable": { "type": "boolean" },
        "precedence": { "type": "integer", "minimum": 0, "maximum": 65535 }
      }
    },
    "limitation": {
      "type": "object", "additionalProperties": false, "required": ["code", "message", "recovery"],
      "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "recovery": { "type": "string" } }
    },
    "helper": {
      "type": "object", "additionalProperties": false, "required": ["executable", "hash", "protocol", "requested_access"],
      "properties": {
        "executable": { "type": "string" },
        "hash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "protocol": { "const": "jsonrpc-2.0" },
        "requested_access": { "type": "array", "items": { "type": "string" } }
      }
    },
    "deprecation": {
      "type": "object", "additionalProperties": false, "required": ["sunset_version", "notice"],
      "properties": {
        "sunset_version": { "type": "string", "minLength": 1 },
        "replacement": { "type": ["string", "null"], "pattern": "^[a-z0-9._-]+$" },
        "notice": { "type": "string", "minLength": 1 }
      }
    }
  }
}
